# MiroFish .env — routed through LiteLLM proxy for usage tracking
# 1. Start proxy: litellm --config litellm-config.yaml --port 4000
# 2. Copy this to .env

LLM_BASE_URL=http://localhost:4000
LLM_API_KEY=your_litellm_master_key   # same value as LITELLM_MASTER_KEY
LLM_MODEL_NAME=qwen-plus               # or gpt-4o, claude-3-5-sonnet

# Zep Cloud - for agent long-term memory
ZEP_API_KEY=your_zep_api_key

# LiteLLM proxy env vars (needed when starting the proxy)
LITELLM_MASTER_KEY=sk-local-mirofish
LLM_API_KEY_UPSTREAM=your_actual_dashscope_or_openai_key
